# Kopiraj v .env.local in prilagodi. Datoteke .env* niso v sistemu git.

# Pot do datoteke SQLite s prijavami zanimanja (privzeto data/vizija3d.sqlite).
# V produkciji mora kazati na trajno shrambo (npr. priklopljen disk).
DATABASE_PATH=data/vizija3d.sqlite

# Javni naslov spletnega mesta (za metapodatke), npr. https://www.primer.si
NEXT_PUBLIC_SITE_URL=

# Omejevanje oddaj: največ RATE_LIMIT_MAX zahtev na IP v RATE_LIMIT_WINDOW_MS milisekundah.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
