# Kopiraj v .env.local in prilagodi. Datoteke .env* niso v sistemu git.

# PRODUKCIJA (Vercel + Supabase): povezava do baze PostgreSQL pri Supabase.
# Supabase → Connect → Connection string → »Transaction pooler« (vrata 6543).
# Primer: postgresql://postgres.<projekt>:<geslo>@<gostitelj>.pooler.supabase.com:6543/postgres
# Ko je nastavljena, se prijave shranjujejo v Supabase. Na Vercelu je obvezna.
DATABASE_URL=

# LOKALNI RAZVOJ (če DATABASE_URL ni nastavljen): datoteka SQLite s prijavami.
DATABASE_PATH=data/vizija3d.sqlite

# Javni naslov spletnega mesta (za metapodatke), npr. https://www.primer.si
NEXT_PUBLIC_SITE_URL=

# Omejevanje oddaj: največ RATE_LIMIT_MAX zahtev na IP v RATE_LIMIT_WINDOW_MS milisekundah.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
